# This sample runs entirely against a local Ollama server — no cloud API key needed.
# Start Ollama and pull the model first:  ollama pull gemma4:e4b

# Base URL of your Ollama server (default shown).
#OLLAMA_HOST=http://localhost:11434

# Model tag to use (default shown). Must be pulled locally.
#OLLAMA_MODEL=gemma4:e4b
